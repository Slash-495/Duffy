# ==============================================================================
# Duffy Backend Configuration
# Copy this file to backend/.env and fill in the required secrets.
# ==============================================================================

# --- Server & Environment ---
# HTTP port for the Express API server (defaults to 5001)
PORT=5001

# Runtime environment: development | production | test
NODE_ENV=development

# Primary frontend origin allowed by CORS (no trailing slash)
CLIENT_URL=http://localhost:5173

# Optional comma-separated list of additional allowed CORS origins
CORS_ORIGINS=

# --- Primary Database (Required) ---
# MongoDB connection string (MongoDB Atlas SRV URI or local mongodb://127.0.0.1:27017/duffy)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/duffy?retryWrites=true&w=majority

# --- Authentication (Required) ---
# High-entropy secret (minimum 32 random bytes) used to sign 7-day HttpOnly JWT cookies
JWT_SECRET_KEY=replace_with_a_long_random_32_byte_secret

# --- Google Gemini AI (Required for AI Coach, Roleplay, Quiz & Transcript Evaluation) ---
# API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Per-request timeout (ms) before aborting a slow Gemini SDK call (default: 12000)
GEMINI_TIMEOUT_MS=12000

# Maximum exponential-backoff retries on transient 429/5xx/timeout Gemini errors (default: 2)
GEMINI_MAX_RETRIES=2

# --- Stream Chat & Video (Required for 1:1 Chat & Video Calls) ---
# Stream application key and server secret from https://getstream.io/
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here

# --- Redis Layer (Optional — app runs in graceful fallback mode if omitted/unreachable) ---
# Connection URL for Redis (local Docker: redis://127.0.0.1:6379, Render Key Value: redis://..., Upstash TLS: rediss://...)
REDIS_URL=redis://127.0.0.1:6379

# Set to "false" to explicitly disable Redis at runtime even when REDIS_URL is present
REDIS_ENABLED=true

# --- Rate Limiting Overrides (Optional) ---
# Sliding-window duration in milliseconds for AI endpoints (default: 900000 = 15 minutes)
AI_RATE_WINDOW_MS=900000

# Maximum AI requests per 15-minute window by subscription tier
AI_RATE_LIMIT_FREE=10
AI_RATE_LIMIT_PREMIUM=60
AI_RATE_LIMIT_PRO=300

# General per-IP API rate limit per 15-minute window (default: 200)
API_RATE_LIMIT_MAX=200
